---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CloseCTA from '@/components/CloseCTA.astro';
import { photos } from '@/data/photos';

const cats = [
  { id: 'all', label: 'All' },
  { id: 'campus', label: 'Campuses' },
  { id: 'learning', label: 'Learning' },
  { id: 'boarding', label: 'Boarding' },
  { id: 'graduates', label: 'Graduates' },
  { id: 'safety', label: 'Safety & transport' },
];
const items = [
  { p: photos.highSchoolArch, cat: 'campus', size: 'wide' },
  { p: photos.labTitration, cat: 'learning', size: 'tall' },
  { p: photos.graduate2, cat: 'graduates', size: 'grad' },
  { p: photos.primaryCourtyard, cat: 'campus', size: 'wide' },
  { p: photos.boardingDormitory, cat: 'boarding', size: '' },
  { p: photos.labPractical, cat: 'learning', size: '' },
  { p: photos.busesHighSchool, cat: 'safety campus', size: 'wide' },
  { p: photos.graduate4, cat: 'graduates', size: 'grad' },
  { p: photos.primaryMuralWall, cat: 'campus', size: '' },
  { p: photos.labFunnel, cat: 'learning', size: 'tall' },
  { p: photos.boardersGroup, cat: 'boarding', size: 'wide' },
  { p: photos.primaryCastleSlide, cat: 'campus', size: '' },
  { p: photos.graduate1, cat: 'graduates', size: 'grad' },
  { p: photos.securityAssembly, cat: 'safety', size: 'wide' },
  { p: photos.labGroup, cat: 'learning', size: '' },
  { p: photos.graduate3, cat: 'graduates', size: 'grad' },
  { p: photos.primaryGreenStairs, cat: 'campus', size: 'wide' },
  { p: photos.securityOfficers, cat: 'safety', size: '' },
  { p: photos.campusWalkway, cat: 'campus', size: 'tall' },
  { p: photos.coveredPlayHall, cat: 'campus', size: '' },
  { p: photos.graduate5, cat: 'graduates', size: 'grad' },
  { p: photos.busesCourtyard, cat: 'safety', size: '' },
  { p: photos.primaryPlaygroundSlide, cat: 'campus', size: 'wide' },
  { p: photos.primaryCourtyardSlide, cat: 'campus', size: '' },
];
// Full-size versions for the lightbox (original resolution, WebP).
const full = await Promise.all(items.map((i) => getImage({ src: i.p.src, format: 'webp', quality: 82 })));
---
<BaseLayout
  title="Gallery — Life at Gulf Flower Schools"
  description="Photographs of Gulf Flower Schools: the primary and high school campuses, science practicals, boarding, graduates and school buses in Oworonshoki, Lagos."
  crumbs={[{ name: 'Gallery', href: '/gallery/' }]}
>
  <PageHero
    eyebrow="Gallery"
    title="Life at <em>Gulf Flower</em>"
    lede="A look around Gulf Flower One and Two — classrooms and courtyards, laboratories, boarding, our graduates and the people who keep the school running."
    crumbs={[{ name: 'Gallery', href: '/gallery/' }]}
    compact
  />

  <section class="section gallery" data-gallery aria-label="Photo gallery">
    <div class="wrap">
      <div class="gal__bar">
        <div class="gal__filters" role="group" aria-label="Filter photographs">
          {cats.map((c, i) => (
            <button type="button" class="gal__filter" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
          ))}
        </div>
        <p class="gal__count" data-gallery-count aria-live="polite">{items.length} photographs</p>
      </div>

      <ul role="list" class="gal__grid" data-gallery-grid>
        {items.map((it, i) => (
          <li class={`gal__item ${it.size}`} data-gallery-item data-cat={it.cat}>
            <a href={full[i].src} class="gal__link" aria-label={`View larger: ${it.p.alt}`}>
              <Picture src={it.p.src} alt={it.p.alt} widths={[320, 480, it.p.src.width].filter((w, j, a) => w <= it.p.src.width && a.indexOf(w) === j)} sizes="(min-width: 1000px) 25vw, (min-width: 640px) 33vw, 50vw" formats={['avif', 'webp']} loading={i < 6 ? 'eager' : 'lazy'} class="gal__img" />
              <span class="gal__zoom" aria-hidden="true"><Icon name="expand" size={18} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <dialog class="lb" data-lightbox aria-label="Photograph viewer">
      <div class="lb__inner">
        <button type="button" class="lb__btn lb__close" data-lb-close aria-label="Close"><Icon name="close" size={22} /></button>
        <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Previous photograph"><Icon name="chev-left" size={26} /></button>
        <figure class="lb__fig">
          <img data-lb-img alt="" />
          <figcaption><span data-lb-caption></span><span class="lb__count" data-lb-counter></span></figcaption>
        </figure>
        <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Next photograph"><Icon name="chev-right" size={26} /></button>
      </div>
    </dialog>
  </section>

  <CloseCTA />
</BaseLayout>

<style>
  .gallery { padding-top: 2rem; }
  .gal__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; position: sticky; top: calc(var(--header-h) + 0.75rem); z-index: 5; }
  .gal__filters { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.35rem; border-radius: var(--r-pill); background: rgb(255 253 249 / 0.9); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm); }
  .gal__filter { min-height: 44px; padding: 0.5rem 1.1rem; border-radius: var(--r-pill); font-weight: 650; font-size: var(--t-sm); transition: background 0.3s, color 0.3s; }
  .gal__filter:hover { background: var(--paper-2); }
  .gal__filter[aria-pressed='true'] { background: var(--wine); color: var(--white); }
  .gal__count { font-size: var(--t-sm); color: var(--ink-3); font-weight: 600; }

  .gal__grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; grid-auto-flow: dense; }
  @media (min-width: 640px) { .gal__grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 190px; } }
  @media (min-width: 1000px) { .gal__grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 210px; gap: 1rem; } }
  .gal__item.wide { grid-column: span 2; }
  .gal__item.tall { grid-row: span 2; }
  .gal__item.grad :global(.gal__img) { object-position: 50% 20%; }
  .gal__link { position: relative; display: block; height: 100%; border-radius: var(--r-md); overflow: hidden; background: var(--paper-3); }
  .gal__link :global(picture) { display: contents; }
  .gal__link :global(.gal__img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out), filter 0.5s; }
  .gal__link:hover :global(.gal__img) { transform: scale(1.06); }
  .gal__link::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(79 15 35 / 0.45), transparent 50%); opacity: 0; transition: opacity 0.4s; }
  .gal__link:hover::after, .gal__link:focus-visible::after { opacity: 1; }
  .gal__zoom { position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 1; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--paper); color: var(--ink); opacity: 0; transform: scale(0.6); transition: opacity 0.35s, transform 0.45s var(--ease-spring); }
  .gal__link:hover .gal__zoom, .gal__link:focus-visible .gal__zoom { opacity: 1; transform: none; }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(20 10 15 / 0.94); color: var(--white); }
  .lb::backdrop { background: transparent; }
  .lb__inner { position: relative; width: 100%; height: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1rem; }
  .lb__fig { display: grid; justify-items: center; gap: 1rem; min-width: 0; }
  .lb__fig img { max-width: min(100%, 900px); max-height: 78dvh; width: auto; height: auto; border-radius: var(--r-md); box-shadow: var(--shadow-lg); }
  .lb__fig figcaption { display: flex; gap: 1rem; justify-content: center; align-items: baseline; max-width: 70ch; text-align: center; font-size: var(--t-sm); color: rgb(255 255 255 / 0.8); }
  .lb__count { flex: none; font-weight: 700; color: var(--sun); }
  .lb__btn { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgb(255 255 255 / 0.1); color: var(--white); transition: background 0.3s, transform 0.3s var(--ease-out); }
  .lb__btn:hover { background: var(--sun); color: var(--ink); }
  .lb__prev:hover { transform: translateX(-3px); }
  .lb__next:hover { transform: translateX(3px); }
  .lb__close { position: absolute; top: 1rem; right: 1rem; z-index: 2; }
  @media (max-width: 640px) {
    .lb__inner { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; padding: 4.5rem 1rem 1.5rem; }
    .lb__fig { grid-column: 1 / -1; grid-row: 1; }
    .lb__prev { grid-row: 2; justify-self: end; }
    .lb__next { grid-row: 2; justify-self: start; }
  }
  :global(html.lb-open) { overflow: hidden; }
</style>
