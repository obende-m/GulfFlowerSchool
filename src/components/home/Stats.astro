---
/** Verified figures only: founding year, number of stages, high-school class size, scholarship categories. */
const stats = [
  { n: 1998, from: 1978, raw: true, label: 'Teaching children in Oworonshoki since', tone: 'wine' },
  { n: 6, label: 'Stages, from Pre-age to Senior Secondary', tone: 'leaf' },
  { n: 25, label: 'Students per high-school classroom, by design', tone: 'sun' },
  { n: 3, label: 'Scholarship awards for learners and the community', tone: 'sky' },
];
---
<section class="stats" aria-label="Gulf Flower Schools in numbers">
  <div class="wrap">
    <ul role="list" class="stats__grid" data-stagger="0.1">
      {stats.map((s) => (
        <li class={`stat stat--${s.tone}`}>
          <span class="stat__num" data-count={s.n} data-from={s.from ?? 0} data-raw={s.raw ? '' : undefined}>{s.n}</span>
          <span class="stat__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .stats { position: relative; margin-top: clamp(-1rem, -2vw, 0rem); padding-bottom: clamp(2rem, 1rem + 3vw, 4rem); }
  .stats__grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .stats__grid { grid-template-columns: repeat(4, 1fr); gap: 1.1rem; } }
  .stat {
    position: relative; overflow: hidden; display: grid; gap: 0.6rem; align-content: space-between;
    min-height: 180px; padding: 1.4rem 1.4rem 1.5rem; border-radius: var(--r-lg);
    transition: transform 0.5s var(--ease-out);
  }
  .stat:hover { transform: translateY(-4px) rotate(-0.6deg); }
  .stat::after { content: ''; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px; border-radius: 50%; background: rgb(255 255 255 / 0.12); transition: transform 0.7s var(--ease-out); }
  .stat:hover::after { transform: scale(1.5); }
  .stat__num { font-family: var(--f-display); font-size: clamp(3rem, 2rem + 3vw, 4.6rem); line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .stat__label { font-size: var(--t-sm); font-weight: 600; line-height: 1.35; max-width: 22ch; }
  .stat--wine { background: var(--wine); color: var(--white); }
  .stat--leaf { background: var(--leaf); color: var(--white); }
  .stat--sun { background: var(--sun); color: var(--ink); }
  .stat--sky { background: var(--sky); color: var(--white); }
  @media (max-width: 480px) { .stat { min-height: 156px; padding: 1.1rem; } }
</style>
