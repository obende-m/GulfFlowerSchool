---
import Photo from '../Photo.astro';
import Button from '../Button.astro';
import { photos } from '@/data/photos';
const tiles = [
  { p: photos.highSchoolCampus, c: 't1' },
  { p: photos.campusWalkway, c: 't2' },
  { p: photos.boardingDormitory, c: 't3' },
  { p: photos.primaryPlaygroundSlide, c: 't4' },
  { p: photos.busesCourtyard, c: 't5' },
];
---
<section class="section gt" aria-labelledby="gt-title">
  <div class="wrap">
    <div class="sh sh--split">
      <div class="stack">
        <span class="eyebrow">Gallery</span>
        <h2 id="gt-title" data-split>A look around <em class="accent--leaf">our campuses</em></h2>
      </div>
      <div class="gt__side" data-reveal>
        <p class="lede">Classrooms, laboratories, boarding and the school day, photographed at Gulf Flower One and Two.</p>
        <Button href="/gallery/" variant="ghost">View the gallery</Button>
      </div>
    </div>
    <div class="gt__grid">
      {tiles.map((t) => (
        <a href="/gallery/" class={`gt__tile ${t.c}`} aria-label={`Open the gallery: ${t.p.alt}`}>
          <Photo photo={t.p} shape="none" sizes="(min-width: 900px) 40vw, 90vw" reveal />
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .gt__side { display: grid; gap: 1.25rem; justify-items: start; }
  .gt__grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; }
  @media (min-width: 900px) { .gt__grid { grid-template-columns: repeat(12, 1fr); grid-auto-rows: 120px; gap: 1rem; } }
  .gt__tile { position: relative; display: block; border-radius: var(--r-lg); overflow: hidden; }
  .gt__tile :global(.frame) { height: 100%; border-radius: inherit; }
  .gt__tile :global(img) { transition: transform 1.1s var(--ease-out), filter 0.6s; }
  .gt__tile:hover :global(img) { transform: scale(1.05); }
  .gt__tile::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 0 var(--sun); transition: box-shadow 0.4s var(--ease-out); pointer-events: none; }
  .gt__tile:hover::after { box-shadow: inset 0 0 0 5px var(--sun); }
  .t1 { grid-column: span 2; grid-row: span 2; }
  @media (min-width: 900px) {
    .t1 { grid-column: 1 / span 6; grid-row: span 4; border-radius: 120px var(--r-lg) var(--r-lg) var(--r-lg); }
    .t2 { grid-column: 7 / span 3; grid-row: span 2; }
    .t3 { grid-column: 10 / span 3; grid-row: span 2; border-radius: var(--r-lg) 90px var(--r-lg) var(--r-lg); }
    .t4 { grid-column: 7 / span 4; grid-row: span 2; }
    .t5 { grid-column: 11 / span 2; grid-row: span 2; border-radius: 999px; }
  }
  @media (max-width: 899px) { .t5 { grid-column: span 2; } }
</style>
