---
import { nav, site, phones, formatPhone, telHref } from '@/data/site';
import Icon from './Icon.astro';
import Petal from './Petal.astro';
import Brand from './Brand.astro';

const path = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) =>
  href === '/' ? path === '/' : path.startsWith(href) || !!children?.some((c) => path.startsWith(c.href));
---
<header class="site-header" data-header>
  <div class="topbar">
    <div class="wrap topbar__inner">
      <p class="topbar__notice">
        <span class="pulse" aria-hidden="true"></span>
        {site.admissionNotice}.
        <a href="/admissions/#enquire" class="topbar__link">Start an enquiry</a>
      </p>
      <ul class="topbar__meta" role="list">
        <li><a href={telHref(phones[0])}><Icon name="phone" size={15} />{formatPhone(phones[0])}</a></li>
        <li class="hide-md"><a href={`mailto:${site.email}`}><Icon name="mail" size={15} />{site.email}</a></li>
        <li><a href="/portals/"><Icon name="key" size={15} />Portals</a></li>
      </ul>
    </div>
  </div>

  <div class="mainbar">
    <div class="wrap mainbar__inner">
      <Brand />

      <nav class="nav" aria-label="Main">
        <ul role="list" class="nav__list">
          {nav.map((item) => (
            <li class:list={['nav__item', item.children && 'has-menu']}>
              <a href={item.href} class:list={['nav__link', isActive(item.href, item.children) && 'is-active']} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
                {item.children && <Icon name="chevron" size={14} class="nav__chev" />}
              </a>
              {item.children && (
                <div class="dropdown">
                  <ul role="list">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="dropdown__link">
                          <Petal size={22} class="dropdown__petal" />
                          <span><strong>{c.label}</strong><small>{c.note}</small></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="mainbar__cta">
        <a href="/admissions/#enquire" class="btn btn--sm cta-desktop">Apply now
          <span class="arrow"><Icon name="arrow" size={18} /><Icon name="arrow" size={18} /></span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span></span>
          <span class="menu-btn__label">Menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <div class="mobile-menu__bg" aria-hidden="true">
    <Petal size={520} class="mm-petal" />
  </div>
  <nav class="wrap mobile-menu__inner" aria-label="Mobile">
    <ul role="list" class="mm-list">
      {nav.map((item, i) => (
        <li class="mm-item">
          <a href={item.href} class:list={['mm-link', isActive(item.href, item.children) && 'is-active']}>
            <span class="mm-num">0{i + 1}</span>{item.label}
          </a>
          {item.children && (
            <ul role="list" class="mm-sub">
              {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="mm-foot mm-item">
      <a href="/admissions/#enquire" class="btn btn--sun">Start an admission enquiry
        <span class="arrow"><Icon name="arrow" size={18} /><Icon name="arrow" size={18} /></span>
      </a>
      <div class="mm-contact">
        <a href={telHref(phones[0])}><Icon name="phone" size={16} />{formatPhone(phones[0])}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />Email the school</a>
        <a href="/portals/"><Icon name="key" size={16} />Portals</a>
      </div>
    </div>
  </nav>
</div>

<style>
  .site-header {
    --topbar-h: 40px;
    position: sticky; top: calc(-1 * var(--topbar-h)); z-index: 100;
    transition: transform 0.45s var(--ease-out);
  }
  .site-header.is-hidden { transform: translateY(-100%); }

  /* Top bar */
  .topbar { height: var(--topbar-h); background: var(--wine-deep); color: rgb(255 253 249 / 0.88); font-size: var(--t-xs); }
  .topbar__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .topbar__notice { display: flex; align-items: center; gap: 0.6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .topbar__link { color: var(--sun); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--sun); flex: none; box-shadow: 0 0 0 0 rgb(242 178 58 / 0.6); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgb(242 178 58 / 0); } 100% { box-shadow: 0 0 0 0 rgb(242 178 58 / 0); } }
  .topbar__meta { display: flex; gap: 1.4rem; }
  .topbar__meta a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; transition: color 0.2s; }
  .topbar__meta a:hover { color: var(--sun); }
  @media (max-width: 1080px) { .hide-md { display: none; } }
  @media (max-width: 720px) {
    .topbar__meta { display: none; }
    .topbar__notice { font-size: 0.75rem; }
  }

  /* Main bar */
  .mainbar {
    height: var(--header-h);
    background: rgb(251 246 238 / 0.82);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
  }
  .site-header.is-scrolled .mainbar { border-color: var(--line); box-shadow: 0 10px 30px -18px rgb(27 31 53 / 0.25); background: rgb(251 246 238 / 0.92); }
  .mainbar__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }

  .nav { display: none; }
  @media (min-width: 1080px) { .nav { display: block; } }
  .nav__list { display: flex; align-items: center; gap: 0.15rem; }
  .nav__item { position: relative; }
  .nav__link {
    position: relative; display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.6rem 0.8rem; min-height: 44px; border-radius: var(--r-pill);
    font-size: 0.9375rem; font-weight: 600; color: var(--ink-2);
    transition: color 0.25s, background 0.25s;
  }
  .nav__link::after {
    content: ''; position: absolute; left: 0.8rem; right: 0.8rem; bottom: 6px; height: 2px; border-radius: 2px;
    background: var(--wine); transform: scaleX(0); transform-origin: right; transition: transform 0.45s var(--ease-out);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__link.is-active { color: var(--wine); background: var(--wine-soft); }
  .nav__link.is-active::after { display: none; }
  .nav__link :global(.nav__chev) { transition: transform 0.3s var(--ease-out); }
  .has-menu:hover :global(.nav__chev), .has-menu:focus-within :global(.nav__chev) { transform: rotate(180deg); }

  .dropdown {
    position: absolute; top: calc(100% + 10px); left: 50%; min-width: 300px;
    padding: 0.6rem; border-radius: var(--r-md); background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translate(-50%, 8px) scale(0.98); transform-origin: top center;
    transition: opacity 0.25s, transform 0.35s var(--ease-out), visibility 0.25s;
  }
  .dropdown::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; }
  .has-menu:hover .dropdown, .has-menu:focus-within .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
  .dropdown__link { display: flex; gap: 0.85rem; align-items: flex-start; padding: 0.8rem 0.9rem; border-radius: 12px; transition: background 0.25s; }
  .dropdown__link:hover { background: var(--paper); }
  .dropdown__link strong { display: block; font-size: 0.9375rem; }
  .dropdown__link small { display: block; color: var(--ink-3); font-size: var(--t-xs); margin-top: 2px; }
  .dropdown__link :global(.dropdown__petal) { color: var(--sun); flex: none; margin-top: 2px; transition: transform 0.6s var(--ease-out); }
  .dropdown__link:hover :global(.dropdown__petal) { transform: rotate(60deg); }

  .mainbar__cta { display: flex; align-items: center; gap: 0.6rem; }
  .cta-desktop { display: none; }
  @media (min-width: 640px) { .cta-desktop { display: inline-flex; } }

  .menu-btn {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0 1rem 0 0.85rem;
    border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-weight: 650; font-size: 0.9375rem;
    position: relative; z-index: 120;
  }
  @media (min-width: 1080px) { .menu-btn { display: none; } }
  @media (max-width: 400px) {
    .menu-btn { width: 48px; padding: 0; justify-content: center; }
    .menu-btn__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  .menu-btn__lines { position: relative; width: 18px; height: 12px; }
  .menu-btn__lines span { position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.4s var(--ease-out), top 0.4s var(--ease-out); }
  .menu-btn__lines span:first-child { top: 1px; }
  .menu-btn__lines span:last-child { top: 9px; }
  .menu-btn[aria-expanded='true'] { background: var(--sun); color: var(--ink); }
  .menu-btn[aria-expanded='true'] .menu-btn__lines span:first-child { top: 5px; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-btn__lines span:last-child { top: 5px; transform: rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 90; background: var(--wine-deep); color: var(--white);
    overflow-y: auto; padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 2rem;
    clip-path: circle(0% at calc(100% - 3rem) 3rem);
    transition: clip-path 0.7s var(--ease-out);
  }
  .mobile-menu.is-open { clip-path: circle(150% at calc(100% - 3rem) 3rem); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .mobile-menu__bg :global(.mm-petal) { position: absolute; right: -180px; bottom: -160px; color: rgb(255 255 255 / 0.05); --petal-centre: rgb(255 255 255 / 0.05); animation: spin-slow 60s linear infinite; }
  @keyframes spin-slow { to { transform: rotate(360deg); } }
  .mobile-menu__inner { position: relative; display: flex; flex-direction: column; gap: 2.5rem; min-height: 100%; }
  .mm-list { display: grid; gap: 0.25rem; }
  .mm-link { display: flex; align-items: baseline; gap: 1rem; padding: 0.35rem 0; font-family: var(--f-display); font-size: clamp(2rem, 8vw, 3rem); line-height: 1.15; letter-spacing: -0.02em; transition: color 0.25s, transform 0.35s var(--ease-out); }
  .mm-link:hover, .mm-link.is-active { color: var(--sun); }
  .mm-link:hover { transform: translateX(6px); }
  .mm-num { font-family: var(--f-sans); font-size: 0.8rem; font-weight: 600; color: rgb(255 255 255 / 0.45); letter-spacing: 0.08em; }
  .mm-sub { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0 0 0.6rem 2.6rem; }
  .mm-sub a { display: inline-flex; min-height: 44px; align-items: center; color: rgb(255 255 255 / 0.72); font-weight: 600; }
  .mm-sub a:hover { color: var(--sun); }
  .mm-foot { margin-top: auto; display: grid; gap: 1.5rem; }
  .mm-foot :global(.btn) { width: 100%; }
  .mm-contact { display: grid; gap: 0.25rem; }
  .mm-contact a { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; color: rgb(255 255 255 / 0.8); font-weight: 600; }
  .js-anim .mobile-menu .mm-item { opacity: 0; transform: translateY(24px); transition: opacity 0.5s, transform 0.6s var(--ease-out); }
  .js-anim .mobile-menu.is-open .mm-item { opacity: 1; transform: none; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(1) { transition-delay: 0.15s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(2) { transition-delay: 0.2s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(3) { transition-delay: 0.25s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(4) { transition-delay: 0.3s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(5) { transition-delay: 0.35s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(6) { transition-delay: 0.4s; }
  .js-anim .mobile-menu.is-open .mm-item:nth-child(7) { transition-delay: 0.45s; }
  .js-anim .mobile-menu.is-open .mm-foot { transition-delay: 0.5s; }
  :global(html.menu-open) { overflow: hidden; }
  :global(html.menu-open) .site-header .mainbar { background: transparent; border-color: transparent; box-shadow: none; backdrop-filter: none; }
  :global(html.menu-open) .site-header :global(.brand) { color: var(--white); }
  :global(html.menu-open) .site-header .cta-desktop { visibility: hidden; }
</style>
