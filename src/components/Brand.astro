---
/** Crest + wordmark. The crest is the school's own 50×50 file — replace with vector artwork when supplied. */
interface Props { tone?: 'ink' | 'light' }
const { tone = 'ink' } = Astro.props;
---
<a href="/" class:list={['brand', tone === 'light' && 'brand--light']} aria-label="Gulf Flower Schools — home">
  <span class="brand__crest"><img src="/crest.png" width="50" height="50" alt="" /></span>
  <span class="brand__text">
    <span class="brand__name">Gulf Flower <em>Schools</em></span>
    <span class="brand__sub">Day &amp; Boarding · Since 1998</span>
  </span>
</a>
<style>
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--ink); min-height: 44px; transition: color 0.3s; }
  .brand--light { color: var(--white); }
  .brand__crest { width: 46px; height: 46px; flex: none; border-radius: 12px; overflow: hidden; background: #000; box-shadow: 0 0 0 2px var(--sun-soft); transition: transform 0.6s var(--ease-spring); }
  .brand:hover .brand__crest { transform: rotate(-6deg) scale(1.05); }
  .brand__crest img { width: 100%; height: 100%; object-fit: cover; }
  .brand__text { display: grid; line-height: 1.05; }
  .brand__name { font-family: var(--f-display); font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; }
  .brand__name em { font-weight: 400; color: var(--wine); }
  .brand--light .brand__name em { color: var(--sun); }
  .brand__sub { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; margin-top: 3px; white-space: nowrap; }
  @media (max-width: 480px) { .brand { gap: 0.55rem; } .brand__crest { width: 40px; height: 40px; border-radius: 10px; } .brand__name { font-size: 1.15rem; } .brand__sub { font-size: 0.6rem; letter-spacing: 0.1em; } }
  @media (max-width: 360px) { .brand__sub { display: none; } }
</style>
